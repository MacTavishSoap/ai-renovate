# ===== AI 家装项目环境变量 =====
# 复制本文件为 .env，填入真实值

# --- 图像生成 API（复用 demo 的 smile-ai 中转）---
IMAGE_API_BASE_URL=https://api.smile-ai-studio.com/v1
IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGE_MODEL=gpt-image-2

# --- LLM API（Pydantic AI Agent 用，可与图像 API 相同）---
LLM_API_BASE_URL=https://api.smile-ai-studio.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# --- 数据库 ---
DATABASE_URL=sqlite:///./data/app.db

# --- 短信服务（阿里云）---
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# --- 对象存储（腾讯云 COS）---
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# --- 超分 API（阿里云）---
SR_ACCESS_KEY_ID=
SR_ACCESS_KEY_SECRET=

# --- 应用 ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
