{
  "_comment": "AI 家装项目配置文件模板 — 复制为 config.json 填入真实值",

  "_note": "providers.* 为主配置格式，支持多 Provider 主备切换；providers 未配置时回退到 legacy 字段",

  "providers": {
    "_comment": "多 Provider 配置，支持主备切换。priority 越大越优先，enabled=false 禁用",
    "_comment2": "当 providers.* 未配置时，回退到 legacy 字段（向下兼容）",

    "llm": [
      {
        "name": "doubao-pro",
        "base_url": "https://ark.cn-beijing.volces.com/api/v3",
        "api_key": "your-api-key",
        "model": "doubao-pro-32k",
        "priority": 10,
        "enabled": true
      },
      {
        "name": "gpt-4o-mini",
        "base_url": "https://api.openai.com/v1",
        "api_key": "sk-xxxx",
        "model": "gpt-4o-mini",
        "priority": 5,
        "enabled": true
      },
      {
        "name": "siliconflow-free",
        "base_url": "https://api.siliconflow.cn/v1",
        "api_key": "sk-xxxx",
        "model": "deepseek-ai/DeepSeek-V2.5",
        "priority": 1,
        "enabled": false
      }
    ],

    "image": [
      {
        "name": "gpt-image-2",
        "base_url": "https://api.openai.com/v1",
        "api_key": "sk-xxxx",
        "model": "gpt-image-2",
        "priority": 10,
        "enabled": true,
        "extra": {
          "default_quality": "high",
          "default_size": "1024x1024"
        }
      },
      {
        "name": "wanxiang",
        "base_url": "https://dashscope.aliyuncs.com/api/v1",
        "api_key": "sk-xxxx",
        "model": "wanx2.1-imagegen",
        "priority": 5,
        "enabled": false
      },
      {
        "name": "doubao-image",
        "base_url": "https://ark.cn-beijing.volces.com/api/v1",
        "api_key": "sk-xxxx",
        "model": "doubao-image-v1",
        "priority": 3,
        "enabled": false
      }
    ],

    "sr": [
      {
        "name": "aliyun-sr",
        "base_url": "https://ivision.cn-shanghai.aliyuncs.com/api/v1",
        "api_key": "your-access-key",
        "secret_key": "your-secret-key",
        "priority": 10,
        "enabled": true
      }
    ],

    "storage": [
      {
        "name": "tencent-cos",
        "priority": 10,
        "enabled": true,
        "extra": {
          "secret_id": "",
          "secret_key": "",
          "bucket": "",
          "region": "ap-guangzhou"
        }
      }
    ]
  },

  "_comment_legacy": "legacy 字段 — providers 未配置时回退到这里",

  "image_api": {
    "_comment": "图像生成 API（legacy，单 Provider）",
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "model": "gpt-image-2",
    "default_quality": "high",
    "default_size": "1024x1024"
  },

  "llm_api": {
    "_comment": "LLM API（legacy，单 Provider）",
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "model": "gpt-4o-mini"
  },

  "aliyun_sms": {
    "_comment": "阿里云短信服务凭证",
    "access_key_id": "",
    "access_key_secret": "",
    "sign_name": "",
    "template_code": ""
  },

  "aliyun_super_res": {
    "_comment": "阿里云视觉智能超分 API 凭证",
    "access_key_id": "",
    "access_key_secret": ""
  },

  "volcengine": {
    "_comment": "火山引擎 AI MediaKit 图像画质增强",
    "api_key": "",
    "endpoint": "https://mediakit.cn-beijing.volces.com"
  },

  "tencent_cos": {
    "_comment": "腾讯云对象存储",
    "secret_id": "",
    "secret_key": "",
    "bucket": "",
    "region": "ap-guangzhou"
  },

  "database": {
    "url": "sqlite:///./data/app.db"
  },

  "super_res": {
    "enabled": false,
    "default_scale": 2,
    "default_format": "jpg",
    "default_quality": 95
  },

  "app": {
    "env": "development",
    "secret_key": "change-me-in-production",
    "host": "0.0.0.0",
    "port": 8000
  },

  "prompts": {
    "global_suffix": "\n重要约束：严格保持原图的空间结构、透视角度、门窗位置和房间形状不变，只改变装修风格与软装陈设。输出照片级写实效果图，画面中不要出现任何文字和水印。 photorealistic interior photograph, professional real estate photography"
  }
}
